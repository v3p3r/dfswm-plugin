{
  "name": "dfswm-compliance-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Word add-in that checks documents against the KDF Defence Forces Service Writing Manual 2024 rulesets.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "sync:rulesets": "node scripts/sync-rulesets.js",
    "icons": "node scripts/generate-icons.js",
    "build:browser": "node scripts/build-browser.js",
    "dev": "npm run build && node scripts/dev-server.js",
    "test": "node --test test/engine.test.js test/presentation.test.js test/evaluators.test.js",
    "validate:rulesets": "python3 ../dfswm-rulesets/scripts/validate_rulesets.py",
    "build": "npm run sync:rulesets && npm run icons && npm run build:browser"
  },
  "engines": {
    "node": ">=18"
  }
}
